# Copiar como .env:  cp .env.example .env
# El .env no se versiona ni se entrega.

# Conexión a la base de datos.
# PostgreSQL del docker-compose de la raíz (puerto 5434 del host):
DATABASE_URL=postgresql://foodstore:foodstore@localhost:5434/foodstore_db

# Firma del JWT: mínimo 32 caracteres. Para generar una clave aleatoria:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambiar-esta-clave-de-al-menos-32-caracteres
ALGORITHM=HS256

# Expiración del token y de la cookie, en minutos.
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Origen del frontend permitido en CORS.
FRONTEND_ORIGIN=http://localhost:5173

# Cookie solo por HTTPS. En desarrollo (http://localhost) debe ser false.
COOKIE_SECURE=false
